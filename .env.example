# Copy to .env. Loaded by api and worker via `node --env-file-if-exists=../../.env`.
NODE_ENV=development
LOG_LEVEL=info
PORT=3001
DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5432/jobpilot
WORKER_CONCURRENCY=4

# Upcoming keys
# LLM layer (Daniil)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Our share of the plan's concurrency units, per process (api and worker each get their own)
LLM_CONCURRENCY_UNITS=4
LLM_TIMEOUT_MS=60000
# LLM_MODEL_PARSE_CV=Qwen/Qwen3-14B
# LLM_UNITS_PARSE_CV=1
# Apify ingestion (Daniil)
# APIFY_TOKEN=
# APIFY_WEBHOOK_SECRET=
# Auth (Artem)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
