# Copy to .env. Loaded by api and worker via `node --env-file-if-exists=../../.env`.
NODE_ENV=development
LOG_LEVEL=info
PORT=3001
DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5432/jobpilot
WORKER_CONCURRENCY=4

