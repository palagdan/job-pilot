# Copy to .env (git-ignored). Loaded by api, worker and db scripts via `node --env-file-if-exists=../../.env`.
# Values below match docker-compose.yml. Each app validates only the variables it uses (packages/config).

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3001
WORKER_CONCURRENCY=4

# --- Database (Postgres 17) ---
DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5432/jobpilot
TEST_DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5432/jobpilot_test

# --- Object storage (S3 API; RustFS locally, R2/S3 in production) ---
# Storage: "local" keeps files in .cache/storage (no S3 needed); "s3" uses the S3_* vars below.
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=../../.cache/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jobpilot
S3_ACCESS_KEY_ID=jobpilot
S3_SECRET_ACCESS_KEY=jobpilot-secret
S3_FORCE_PATH_STYLE=true
# Browser-facing endpoint for signed URLs, only if it differs from S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
# Enables storage integration tests against the docker RustFS.
TEST_S3_ENDPOINT=http://localhost:9000

# --- Email (Resend in production) ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="JobPilot <hello@jobpilot.local>"
# Empty = no sending: each email is written as an .html file to EMAIL_PREVIEW_DIR (open it in a browser).
RESEND_API_KEY=
# EMAIL_PREVIEW_DIR=../../.cache/emails

# --- Auth (Better Auth + Google) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public web origin. The browser reaches the api through Next rewrites (/api/auth/*, /v1/*).
WEB_URL=http://localhost:3000
# Google Cloud console → OAuth client (Web). Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Leave empty to run without Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails allowed to open the ops view (/ops), comma-separated.
ADMIN_EMAILS=

# --- Web (Next.js server side) ---
# Also the public api origin used in email unsubscribe links (worker reads it too).
API_URL=http://localhost:3001
# Show the maintenance page on every web route (spec §11).
MAINTENANCE_MODE=false

# --- LLM (Featherless) ---
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Our share of the plan's concurrency units, per process (api and worker each get their own)
LLM_CONCURRENCY_UNITS=4
LLM_TIMEOUT_MS=60000
# LLM_MODEL_PARSE_CV=Qwen/Qwen3-14B
# LLM_UNITS_PARSE_CV=1

# --- Apify ingestion (worker) ---
APIFY_TOKEN=
APIFY_MAX_ITEMS=200
APIFY_MAX_CHARGE_USD=1
# Webhook endpoint comes when the api is publicly reachable; locally the worker polls.
# APIFY_WEBHOOK_SECRET=

# --- Upcoming keys ---

# --- Docker port overrides (only if the defaults are taken) ---
# POSTGRES_PORT=5432
# STORAGE_PORT=9000
# STORAGE_CONSOLE_PORT=9001
# MAILPIT_UI_PORT=8025
