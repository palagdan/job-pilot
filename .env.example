# Copy to .env (git-ignored). Loaded by api, worker and db scripts via `node --env-file-if-exists=../../.env`.
# Values below match docker-compose.yml. Each app validates only the variables it uses (packages/config).

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3001
WORKER_CONCURRENCY=4

# --- Database (Postgres 17) ---
DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5432/jobpilot
TEST_DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5432/jobpilot_test

# --- Object storage (S3 API; RustFS locally, R2/S3 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jobpilot
S3_ACCESS_KEY_ID=jobpilot
S3_SECRET_ACCESS_KEY=jobpilot-secret
S3_FORCE_PATH_STYLE=true

# --- Email (Mailpit locally via SMTP; Resend in production) ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="JobPilot <hello@jobpilot.local>"
RESEND_API_KEY=

# --- Upcoming keys ---
# LLM layer (Daniil)
# FEATHERLESS_API_KEY=
# Apify ingestion (Daniil)
# APIFY_TOKEN=
# APIFY_WEBHOOK_SECRET=
# Auth (Artem)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=

# --- Docker port overrides (only if the defaults are taken) ---
# POSTGRES_PORT=5432
# STORAGE_PORT=9000
# STORAGE_CONSOLE_PORT=9001
# MAILPIT_UI_PORT=8025
