{
  "name": "@job-pilot/db",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./migrator": "./src/migrator.ts",
    "./schema/*": "./src/schema/*.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:migrate:test": "node --env-file-if-exists=../../.env src/scripts/migrate.ts --test",
    "db:seed": "node --env-file-if-exists=../../.env src/scripts/seed.ts",
    "db:reset": "node --env-file-if-exists=../../.env src/scripts/reset.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@job-pilot/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
