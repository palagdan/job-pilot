{
  "name": "@job-pilot/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "agent:run": "node --env-file-if-exists=../../.env src/scripts/run-agent.ts",
    "source:run": "node --env-file-if-exists=../../.env src/scripts/run-source.ts"
  },
  "dependencies": {
    "@job-pilot/apify": "workspace:*",
    "@job-pilot/config": "workspace:*",
    "@job-pilot/db": "workspace:*",
    "@job-pilot/emails": "workspace:*",
    "@job-pilot/jobs": "workspace:*",
    "@job-pilot/llm": "workspace:*",
    "@job-pilot/logger": "workspace:*",
    "@job-pilot/shared": "workspace:*",
    "@job-pilot/storage": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "mammoth": "^1.13.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
